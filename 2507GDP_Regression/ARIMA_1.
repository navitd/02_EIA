
"""
g7_gdp_arima_predict.py

Usage:
    python g7_gdp_arima_predict.py --file path/to/g7_gdp.csv
"""

import os
import argparse
import warnings
from typing import Tuple

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Try to use pmdarima for auto_arima; fallback strategy included
try:
    import pmdarima as pm
    PMDARIMA_AVAILABLE = True
except Exception:
    PMDARIMA_AVAILABLE = False

# Prefer statsmodels' ARIMA / SARIMAX for final fit
from statsmodels.tsa.statespace.sarimax import SARIMAX
from statsmodels.tsa.stattools import adfuller

warnings.filterwarnings("ignore")  # keep output readable; remove if you want full diagnostics


def load_and_clean(path: str, year_col: str = "Year") -> pd.DataFrame:
    """
    Load CSV and return DataFrame indexed by a datetime index (annual frequency).
    Expects one column containing years and other columns are country GDPs (numeric).
    """
    df = pd.read_csv(path)
    if year_col not in df.columns:
        # Try common alternatives
        alt = [c for c in df.columns if 'year' in c.lower()]
        if alt:
            year_col = alt[0]
        else:
            raise ValueError(f"Year column '{year_col}' not found and no alternative discovered. Columns: {df.columns.tolist()}")

    # Make sure years are integers
    df = df.copy()
    df[year_col] = pd.to_numeric(df[year_col], errors='coerce').astype(pd.Int64Dtype())
    df = df.dropna(subset=[year_col])
    df[year_col] = df[year_col].astype(int)

    # Set datetime index at Jan 1 of year for annual frequency
    df['year_dt'] = pd.to_datetime(df[year_col].astype(str) + '-01-01')
    df = df.set_index('year_dt').sort_index()

    # Drop original year column to leave only country columns
    df = df.drop(columns=[col for col in [year_col] if col in df.columns] , errors='ignore')

    # Convert all remaining columns to numeric (coerce non-numeric to NaN)
    for c in df.columns:
        df[c] = pd.to_numeric(df[c], errors='coerce')

    # Optionally, forward/backward fill small gaps, but do not extrapolate long missing sections
    df = df.interpolate(method='linear', limit=2)  # allow up to 2-year linear interpolation
    df = df.fillna(method='ffill').fillna(method='bfill')

    return df


def check_stationarity(ts: pd.Series, signif: float = 0.05) -> Tuple[bool, float]:
    """
    Perform ADF test; return (is_stationary, p_value).
    Note: for yearly GDP it's common to have unit root (non-stationary).
    """
    try:
        res = adfuller(ts.dropna(), autolag='AIC')
        pval = float(res[1])
        return (pval < signif, pval)
    except Exception:
        return (False, np.nan)


def select_arima_order(ts: pd.Series, seasonal: bool = False, m: int = 1):
    """
    Use pmdarima.auto_arima to select order if available; otherwise fall back to a simple heuristic.
    Returns (order, seasonal_order)
    """
    if PMDARIMA_AVAILABLE:
        try:
            # yearly data => seasonal=False by default
            stepwise = True
            # allow differencing detection
            model = pm.auto_arima(
                ts.dropna(),
                seasonal=seasonal,
                m=m,
                start_p=0, start_q=0,
                max_p=3, max_q=3,
                start_P=0, start_Q=0,
                max_P=2, max_Q=2,
                d=None,
                D=1 if seasonal else 0,
                trace=False,
                error_action='ignore',
                suppress_warnings=True,
                stepwise=stepwise,
                n_jobs=1
            )
            order = tuple(model.order)
            seasonal_order = tuple(model.seasonal_order)
            return order, seasonal_order
        except Exception:
            pass

    # Fallback simple heuristic: try ARIMA(1,1,1)
    return (1, 1, 1), (0, 0, 0, 0)


def fit_and_forecast(ts: pd.Series, country: str, steps: int = 5):
    """
    Fit SARIMAX/ARIMA and forecast `steps` future periods.
    Returns forecast_series (pd.Series indexed by future datetimes), fitted_results object.
    """
    # Basic checks
    if ts.dropna().shape[0] < 10:
        raise ValueError(f"Not enough observations for {country} (need >=10 years); found {ts.dropna().shape[0]}")

    # Seasonal for annual data is typically not used (m=1), set seasonal=False
    order, seasonal_order = select_arima_order(ts, seasonal=False, m=1)

    # Ensure seasonal_order is length 4
    if len(seasonal_order) != 4:
        seasonal_order = (0, 0, 0, 0)

    # Fit SARIMAX (non-seasonal ARIMA)
    try:
        model = SARIMAX(
            ts,
            order=order,
            seasonal_order=seasonal_order if seasonal_order != (0, 0, 0, 0) else (0, 0, 0, 0),
            enforce_stationarity=False,
            enforce_invertibility=False
        )
        res = model.fit(disp=False)
    except Exception as e:
        # fallback: try simple ARIMA(1,1,1)
        print(f"Warning: model fit failed for {country} with order {order}. Error: {e}. Falling back to ARIMA(1,1,1).")
        model = SARIMAX(ts, order=(1, 1, 1), enforce_stationarity=False, enforce_invertibility=False)
        res = model.fit(disp=False)

    # Forecast
    forecast_res = res.get_forecast(steps=steps)
    fc = forecast_res.predicted_mean
    ci = forecast_res.conf_int(alpha=0.05)

    # Index for forecasts: yearly, continue from last year
    last_year = ts.index[-1].year
    future_index = pd.to_datetime([f"{y}-01-01" for y in range(last_year + 1, last_year + 1 + steps)])
    fc.index = future_index
    ci.index = future_index

    # Build DataFrame with forecast and CI
    fc_df = pd.DataFrame({
        'forecast': fc,
        'ci_lower': ci.iloc[:, 0],
        'ci_upper': ci.iloc[:, 1]
    }, index=future_index)

    return fc_df, res


def plot_and_save(ts: pd.Series, fc_df: pd.DataFrame, country: str, outdir: str):
    """
    Plot historical series + forecast and save PNG to outdir.
    """
    plt.figure(figsize=(10, 5))
    ts.plot(label='Observed', marker='o')
    fc_df['forecast'].plot(label='Forecast', marker='o')
    plt.fill_between(fc_df.index, fc_df['ci_lower'], fc_df['ci_upper'], alpha=0.25)
    plt.title(f"{country} GDP — observed + forecast")
    plt.ylabel("GDP")
    plt.legend()
    plt.grid(alpha=0.3)
    fname = os.path.join(outdir, f"{country.replace(' ', '_')}_forecast.png")
    plt.savefig(fname, bbox_inches='tight', dpi=150)
    plt.close()


def main(args):
    # create output dir
    outdir = args.outdir
    os.makedirs(outdir, exist_ok=True)

    print("Loading and cleaning data...")
    df = load_and_clean(args.file, year_col=args.year_col)
    print(f"Data loaded. Time span: {df.index.min().year} to {df.index.max().year}. Countries: {list(df.columns)}")

    forecasts = []

    for country in df.columns:
        print(f"\nProcessing: {country}")
        ts = df[country].dropna()
        try:
            # require at least 10 observations
            if ts.shape[0] < 10:
                print(f"  Skipping {country}: only {ts.shape[0]} observations (need >=10).")
                continue

            # stationary check info (informational only)
            is_stat, pval = check_stationarity(ts)
            print(f"  ADF p-value = {pval:.4f} -> stationary = {is_stat}")

            fc_df, res = fit_and_forecast(ts, country, steps=args.horizon)
            plot_and_save(ts, fc_df, country, outdir)

            # attach metadata and append
            for dt, row in fc_df.iterrows():
                forecasts.append({
                    'country': country,
                    'year': dt.year,
                    'forecast': float(row['forecast']),
                    'ci_lower': float(row['ci_lower']),
                    'ci_upper': float(row['ci_upper']),
                    'model_aic': float(res.aic) if hasattr(res, 'aic') else np.nan
                })

            print(f"  Forecast for next {args.horizon} years saved and plotted.")
        except Exception as e:
            print(f"  ERROR processing {country}: {e}")

    # Save forecasts to CSV
    if forecasts:
        out_df = pd.DataFrame(forecasts).sort_values(['country', 'year'])
        out_csv = os.path.join(outdir, "g7_gdp_forecasts.csv")
        out_df.to_csv(out_csv, index=False)
        print(f"\nAll forecasts saved to: {out_csv}")
    else:
        print("\nNo forecasts produced.")

    print(f"Plots saved to: {outdir}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Load G7 GDP CSV and forecast next N years using ARIMA.")
    parser.add_argument("--file", "-f", required=True, help="Path to CSV file. Must have a Year column and one column per country.")
    parser.add_argument("--year-col", default="Year", help="Name of the year column in CSV (default: 'Year').")
    parser.add_argument("--horizon", "-n", type=int, default=5, help="Forecast horizon in years (default 5).")
    parser.add_argument("--outdir", "-o", default="output", help="Directory to save forecasts and plots.")
    args = parser.parse_args()

    main(args)
